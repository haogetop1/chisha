<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：暖橙色碗里装满白米饭，一双筷子平放在碗的右侧。
  视口 108x108，所有内容都收在中心直径 66 的安全区内（不会被各家遮罩切掉）。
  布局：碗占 x 22..52，筷子平放在 x 58..84，中间留约 6dp 空隙，整体重心仍在 x=54。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 碗身 -->
    <path
        android:fillColor="#C8551F"
        android:pathData="M22,56 C22,67.5 28.5,72.5 37,72.5 C45.5,72.5 52,67.5 52,56 Z" />

    <!-- 碗口内壁（比碗身深一档，做出里面有东西的层次） -->
    <path
        android:fillColor="#A8431A"
        android:pathData="M22,56a15,4.6 0 1,0 30,0a15,4.6 0 1,0 -30,0" />

    <!-- 白米饭：从碗口里冒出来的一个圆丘 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M25,56 C26,46.5 30.5,42.5 37,42.5 C43.5,42.5 48,46.5 49,56 Z" />

    <!-- 饭的底部压一层浅暖色，避免纯白在暖白背景上糊成一片 -->
    <path
        android:fillColor="#F1E4D2"
        android:pathData="M25,56 C27,53.2 31.5,51.4 37,51.4 C42.5,51.4 47,53.2 49,56 Z" />

    <!-- 筷子：一双，平放在碗的右侧，水平横躺、上下各一根 -->
    <path
        android:fillColor="#8C6239"
        android:pathData="M59.6,51.4 h22.8 a1.6,1.6 0 0 1 0,3.2 h-22.8 a1.6,1.6 0 0 1 0,-3.2 z" />
    <path
        android:fillColor="#7A5430"
        android:pathData="M59.6,59.4 h22.8 a1.6,1.6 0 0 1 0,3.2 h-22.8 a1.6,1.6 0 0 1 0,-3.2 z" />
</vector>
