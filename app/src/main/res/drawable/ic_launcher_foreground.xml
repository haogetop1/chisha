<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：就一只暖橙色碗，碗里装满白米饭。没有筷子。
  视口 108x108，碗居中（cx=54），所有内容都收在中心直径 66 的安全区内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 碗身 -->
    <path
        android:fillColor="#C8551F"
        android:pathData="M28,58 C28,71.5 39,78 54,78 C69,78 80,71.5 80,58 Z" />

    <!-- 碗口内壁（比碗身深一档，做出里面有东西的层次） -->
    <path
        android:fillColor="#A8431A"
        android:pathData="M28,58a26,6 0 1,0 52,0a26,6 0 1,0 -52,0" />

    <!-- 白米饭：从碗口里冒出来的一个圆丘 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,58 C34,46 43,40 54,40 C65,40 74,46 75,58 Z" />

    <!-- 饭的底部压一层浅暖色，避免纯白在暖白背景上糊成一片 -->
    <path
        android:fillColor="#F1E4D2"
        android:pathData="M33,58 C36,54.5 44,52.5 54,52.5 C64,52.5 72,54.5 75,58 Z" />
</vector>
